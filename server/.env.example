# Copie para .env (na raiz do projeto, para o docker compose) ou exporte no ambiente do servidor.

# Senha do PostgreSQL usada pelo docker-compose.yml (troque!)
POSTGRES_PASSWORD=troque-esta-senha

# Conexão com o banco (fora do docker compose). Em serviços gerenciados (Neon, Supabase, Render…)
# use a URL que eles fornecem, normalmente com ?sslmode=require
DATABASE_URL=postgres://canteiro:troque-esta-senha@localhost:5432/canteiro

# Porta HTTP da API
PORT=3000

# Sites que podem usar a API pelo navegador, separados por vírgula.
# O próprio endereço do servidor não precisa estar aqui.
CORS_ORIGENS=https://canjango.github.io

# Pasta do aplicativo exportado (npm run build na raiz gera out/). Vazio = só a API.
PASTA_APP=../out

# 1 quando estiver atrás de proxy/HTTPS (Render, Railway, Nginx, Caddy)
CONFIAR_PROXY=0

# Aplica as migrações do banco ao iniciar (padrão: 1)
MIGRAR_AO_INICIAR=1
