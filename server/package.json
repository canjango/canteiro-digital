{
  "name": "canteiro-digital-servidor",
  "version": "1.0.0",
  "private": true,
  "description": "API do Canteiro Digital: Node.js + Express + PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrar": "node dist/migrar.js",
    "migrar:dev": "tsx src/migrar.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
